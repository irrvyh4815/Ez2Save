# Supabase public client settings for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only user management settings for Vercel API routes.
# Never prefix SUPABASE_SERVICE_ROLE_KEY with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_RATE_LIMIT_PER_MINUTE=30

# Optional server-side AI settings for Vercel API routes. Never expose these with VITE_.
AI_ENABLED=false
AI_MOCK_MODE=true
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=5
AI_CACHE_TTL_SECONDS=86400

# Optional CSV and request safety limits.
MAX_CSV_ROWS=500
MAX_AI_SUMMARY_ITEMS=120
